<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@color/gradientInicio"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <Button
                android:id="@+id/btn_perfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="24dp"
                android:backgroundTint="#00FFFFFF"
                android:drawableTop="@drawable/ic_user"
                android:drawableTint="#FFFFFF"
                android:scaleX="2"
                android:scaleY="2"
                android:text="Perfil"
                android:textSize="10sp"
                app:iconGravity="start"
                app:iconPadding="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/btn_qr_scan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="48dp"
                android:backgroundTint="#00FFFFFF"
                android:drawableTop="@drawable/ic_qr_scan"
                android:drawableTint="#FFFFFF"
                android:scaleX="2"
                android:scaleY="2"
                android:text="QR Scan"
                android:textSize="10sp"
                app:iconGravity="start"
                app:iconPadding="0dp"
                app:layout_constraintEnd_toStartOf="@+id/btn_perfil"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/btn_cronograma"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="48dp"
                android:backgroundTint="#00FFFFFF"
                android:drawableTop="@drawable/ic_clock"
                android:drawableTint="#FFFFFF"
                android:scaleX="2"
                android:scaleY="2"
                android:text="Cronograma"
                android:textSize="10sp"
                app:iconGravity="start"
                app:iconPadding="0dp"
                app:layout_constraintEnd_toStartOf="@+id/btn_qr_scan"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.bottomnavigation.BottomNavigationView>

</androidx.constraintlayout.widget.ConstraintLayout>